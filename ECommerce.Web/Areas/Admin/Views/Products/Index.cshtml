@model ECommerce.Application.Common.PagedResult<ECommerce.Application.DTOs.ProductDto>
@{
    ViewData["Title"] = "Manage Products";
    var categories = ViewBag.Categories as IReadOnlyList<ECommerce.Application.DTOs.CategoryDto> ?? new List<ECommerce.Application.DTOs.CategoryDto>();
    var filter = ViewBag.Filter as ECommerce.Application.DTOs.ProductFilterDto ?? new ECommerce.Application.DTOs.ProductFilterDto();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
    <div>
        <h1 class="h3 font-display text-white mb-1">
            <i class="bi bi-box-seam-fill text-purple me-2"></i>PRODUCT INVENTORY MANAGEMENT
        </h1>
        <p class="text-secondary small mb-0">Total <span class="text-cyan fw-bold">@Model.TotalCount</span> products deployed across grid nodes.</p>
    </div>
    <div>
        <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-cyber-primary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-plus-circle-fill"></i> Deploy New Product
        </a>
    </div>
</div>

<!-- Search & Category Filter Toolbar -->
<div class="glass-panel p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-dark border-secondary text-cyan"><i class="bi bi-search"></i></span>
                <input type="text" name="Query" class="form-control form-control-cyber" placeholder="Search by name, SKU, description..." value="@filter.Query" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="CategoryId" class="form-select form-select-cyber form-select-sm" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(filter.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-cyber-cyan btn-sm flex-grow-1">Filter</button>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-cyber-outline btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-cyber mb-0 align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-center">Stock</th>
                    <th class="text-center">Featured</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="glass-card p-1 text-center" style="width: 44px; height: 44px; border-radius: 8px; background: #0c0e17;">
                                    <img src="@p.PrimaryImageUrl" alt="@p.Name" class="w-100 h-100 object-fit-contain" />
                                </div>
                                <div>
                                    <span class="text-white font-heading fw-bold small d-block">@p.Name</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">Slug: @p.Slug</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="font-display small text-secondary">@p.SKU</span>
                        </td>
                        <td>
                            <span class="badge-cyber badge-cyber-purple small">@p.CategoryName</span>
                        </td>
                        <td class="text-end font-display fw-bold text-white small">
                            $@p.Price.ToString("F2")
                            @if (p.HasDiscount)
                            {
                                <div class="text-muted text-decoration-line-through" style="font-size: 0.7rem;">$@p.OriginalPrice?.ToString("F2")</div>
                            }
                        </td>
                        <td class="text-center">
                            @if (p.StockQuantity <= 5)
                            {
                                <span class="badge-cyber badge-cyber-red">@p.StockQuantity units</span>
                            }
                            else
                            {
                                <span class="badge-cyber badge-cyber-green">@p.StockQuantity units</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (p.IsFeatured)
                            {
                                <i class="bi bi-star-fill text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted"></i>
                            }
                        </td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge-cyber badge-cyber-cyan">ACTIVE</span>
                            }
                            else
                            {
                                <span class="badge-cyber badge-cyber-red">INACTIVE</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-cyber-outline btn-sm py-1 px-2" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Deactivate or delete this product?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link text-danger p-0 ms-2" title="Delete">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

