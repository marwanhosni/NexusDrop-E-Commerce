@model IReadOnlyList<ECommerce.Application.DTOs.UserManagementDto>
@{
    ViewData["Title"] = "Customer Identities Roster";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
    <div>
        <h1 class="h3 font-display text-white mb-1">
            <i class="bi bi-people-fill text-warning me-2"></i>OPERATOR IDENTITIES ROSTER
        </h1>
        <p class="text-secondary small mb-0">Registered user telemetry, identity roles, and order activity.</p>
    </div>
    <div>
        <span class="badge-cyber badge-cyber-purple fs-6">@Model.Count Registered Users</span>
    </div>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-cyber mb-0 align-middle">
            <thead>
                <tr>
                    <th>Operator Identity</th>
                    <th>Neural Dispatch Email</th>
                    <th>Phone / Comms</th>
                    <th>Access Role</th>
                    <th class="text-center">Orders Placed</th>
                    <th class="text-end">Registered Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="p-1 rounded-circle glass-card border-secondary text-cyan">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="text-white font-heading fw-bold small">@user.FullName</span>
                            </div>
                        </td>
                        <td>
                            <span class="text-cyan small font-display">@user.Email</span>
                        </td>
                        <td>
                            <span class="small text-secondary">@(string.IsNullOrEmpty(user.PhoneNumber) ? "Not registered" : user.PhoneNumber)</span>
                        </td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge-cyber badge-cyber-purple"><i class="bi bi-shield-lock-fill me-1"></i>ADMIN</span>
                            }
                            else
                            {
                                <span class="badge-cyber badge-cyber-cyan">CUSTOMER</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge-cyber badge-cyber-green">@user.OrderCount Orders</span>
                        </td>
                        <td class="text-end small text-secondary font-heading">
                            @user.CreatedAt.ToString("yyyy-MM-dd")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

