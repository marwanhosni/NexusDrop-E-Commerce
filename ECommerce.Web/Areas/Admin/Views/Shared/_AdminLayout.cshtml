<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marwan Hosny Store | Admin Command Deck</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/futuristic.css" asp-append-version="true" />
</head>
<body style="background-color: #07080d;">
    <!-- Admin Top Navbar -->
    <header class="glass-nav py-2 border-bottom border-secondary border-opacity-25">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="navbar-brand-cyber text-decoration-none">
                    <img src="~/images/logo.svg" alt="Marwan Hosny Store" style="height: 32px;" />
                </a>
                <span class="badge-cyber badge-cyber-purple d-none d-md-inline-block">COMMAND DECK v2.6</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-cyber-outline btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-box-arrow-up-right text-cyan"></i>
                    <span class="d-none d-sm-inline">Public Storefront</span>
                </a>

                <div class="d-flex align-items-center gap-2 ps-3 border-start border-secondary border-opacity-50">
                    <div class="p-1 rounded-circle glass-card border-purple text-purple">
                        <i class="bi bi-person-fill fs-6"></i>
                    </div>
                    <span class="small font-heading text-white fw-bold d-none d-sm-inline">@User.Identity?.Name</span>

                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-0 small text-decoration-none" title="Disconnect Admin">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <div class="container-fluid px-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-2 col-md-3 admin-sidebar">
                <div class="small font-display text-muted text-uppercase mb-3 px-3" style="letter-spacing: 2px;">
                    Control Sectors
                </div>
                <nav class="d-flex flex-column">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" 
                       class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2 text-cyan"></i> Overview
                    </a>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" 
                       class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")">
                        <i class="bi bi-box-seam-fill text-purple"></i> Products
                    </a>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" 
                       class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">
                        <i class="bi bi-tags-fill text-pink"></i> Categories
                    </a>
                    <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" 
                       class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" ? "active" : "")">
                        <i class="bi bi-layers-fill text-blue"></i> Inventory Stock
                    </a>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" 
                       class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "active" : "")">
                        <i class="bi bi-cart-check-fill text-success"></i> Orders &amp; Sales
                    </a>
                    <a asp-area="Admin" asp-controller="Customers" asp-action="Index" 
                       class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")">
                        <i class="bi bi-people-fill text-warning"></i> Customer Roster
                    </a>
                </nav>

                <div class="mt-5 pt-4 border-top border-secondary border-opacity-25 px-3">
                    <div class="small text-muted font-heading">CORE STATUS:</div>
                    <div class="small text-cyan font-display fw-bold">ONLINE (100%)</div>
                    <div class="small text-muted font-heading mt-2">ENGINE:</div>
                    <div class="small text-white font-heading">.NET 9 + EF Core</div>
                </div>
            </div>

            <!-- Main Admin Workspace -->
            <div class="col-lg-10 col-md-9 p-4 p-md-5">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success glass-panel border-cyan text-white alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-check-circle-fill text-cyan fs-5 me-3"></i>
                        <div class="font-heading fw-semibold">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger glass-panel border-pink text-white alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-pink fs-5 me-3"></i>
                        <div class="font-heading fw-semibold">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cyber.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

