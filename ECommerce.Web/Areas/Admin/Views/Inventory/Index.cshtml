@model IReadOnlyList<ECommerce.Application.DTOs.ProductDto>
@{
    ViewData["Title"] = "Inventory Stock Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
    <div>
        <h1 class="h3 font-display text-white mb-1">
            <i class="bi bi-layers-fill text-blue me-2"></i>INVENTORY STOCK MONITOR
        </h1>
        <p class="text-secondary small mb-0">Rapid batch adjustments of physical warehouse stock and low-buffer alerts.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge-cyber badge-cyber-cyan">@Model.Count Total Products</span>
        <span class="badge-cyber badge-cyber-red">@Model.Count(p => p.StockQuantity <= 5) Low Stock</span>
    </div>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-cyber mb-0 align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Unit Price</th>
                    <th class="text-center">Current Stock</th>
                    <th style="min-width: 200px;">Quick Stock Update</th>
                    <th class="text-end">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="glass-card p-1 text-center" style="width: 40px; height: 40px; border-radius: 8px; background: #0c0e17;">
                                    <img src="@p.PrimaryImageUrl" alt="@p.Name" class="w-100 h-100 object-fit-contain" />
                                </div>
                                <span class="text-white font-heading fw-bold small">@p.Name</span>
                            </div>
                        </td>
                        <td>
                            <span class="font-display small text-secondary">@p.SKU</span>
                        </td>
                        <td>
                            <span class="badge-cyber badge-cyber-purple small">@p.CategoryName</span>
                        </td>
                        <td class="font-display text-white small">
                            $@p.Price.ToString("F2")
                        </td>
                        <td class="text-center font-display fw-bold">
                            @if (p.StockQuantity <= 5)
                            {
                                <span class="badge-cyber badge-cyber-red">@p.StockQuantity UNITS (LOW)</span>
                            }
                            else
                            {
                                <span class="badge-cyber badge-cyber-green">@p.StockQuantity UNITS</span>
                            }
                        </td>
                        <td>
                            <form asp-area="Admin" asp-controller="Inventory" asp-action="UpdateStock" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="number" name="stockQuantity" value="@p.StockQuantity" min="0" max="99999" class="form-control form-control-cyber form-control-sm text-center font-display fw-bold" style="width: 85px;" />
                                <button type="submit" class="btn btn-cyber-primary btn-sm py-1 px-3">
                                    <i class="bi bi-check2"></i> Set
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <span class="badge-cyber @(p.IsActive ? "badge-cyber-cyan" : "badge-cyber-red")">
                                @(p.IsActive ? "ACTIVE" : "INACTIVE")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

