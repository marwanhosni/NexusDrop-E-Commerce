@model ECommerce.Application.DTOs.OrderDto
@{
    ViewData["Title"] = $"Fulfill Order {Model.OrderNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
    <div>
        <h1 class="h3 font-display text-white mb-1">
            <i class="bi bi-box-seam text-cyan me-2"></i>ORDER FULFILLMENT TERMINAL: @Model.OrderNumber
        </h1>
        <p class="text-secondary small mb-0">Inspect items, verify settlements, and advance dispatch status.</p>
    </div>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-cyber-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Orders
    </a>
</div>

<div class="row g-4">
    <!-- Left: Items & Delivery Coordinates -->
    <div class="col-lg-8">
        <!-- Purchased items -->
        <div class="glass-panel p-4 mb-4">
            <h5 class="h6 font-display text-white mb-3 text-uppercase" style="letter-spacing: 1px;">
                Ordered Artifacts
            </h5>

            <div class="table-responsive">
                <table class="table table-cyber mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                        {
                                            <div class="glass-card p-1 text-center" style="width: 44px; height: 44px; border-radius: 8px; background: #0c0e17;">
                                                <img src="@item.ProductImageUrl" alt="@item.ProductName" class="w-100 h-100 object-fit-contain" />
                                            </div>
                                        }
                                        <div>
                                            <span class="text-white font-heading fw-bold small">@item.ProductName</span>
                                            <div class="text-muted" style="font-size: 0.75rem;">Product ID: #@item.ProductId</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center font-display text-white small">@item.Quantity</td>
                                <td class="text-end font-display text-secondary small">$@item.UnitPrice.ToString("F2")</td>
                                <td class="text-end font-display text-cyan fw-bold small">$@item.TotalPrice.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 row">
                <div class="col-sm-6">
                    <span class="small font-display text-secondary text-uppercase d-block mb-1">Carrier Notes:</span>
                    <p class="small text-white fst-italic mb-0">@(string.IsNullOrEmpty(Model.Notes) ? "None specified by customer." : Model.Notes)</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <div class="small text-secondary">Subtotal: <strong class="text-white font-display">$@Model.Subtotal.ToString("F2")</strong></div>
                    <div class="small text-secondary">Shipping: <strong class="text-white font-display">$@Model.ShippingCost.ToString("F2")</strong></div>
                    <div class="small text-secondary">Tax (8%): <strong class="text-white font-display">$@Model.TaxAmount.ToString("F2")</strong></div>
                    <div class="h5 font-display text-cyan fw-bold mt-2">Total: $@Model.TotalAmount.ToString("F2")</div>
                </div>
            </div>
        </div>

        <!-- Customer Telemetry Coordinates -->
        <div class="glass-panel p-4">
            <h5 class="h6 font-display text-white mb-3 text-uppercase" style="letter-spacing: 1px;">
                Recipient Telemetry
            </h5>
            <div class="row g-3 small">
                <div class="col-sm-6">
                    <span class="text-muted d-block font-heading">FULL NAME</span>
                    <span class="text-white fw-bold">@Model.CustomerName</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block font-heading">EMAIL ADDRESS</span>
                    <span class="text-cyan">@Model.CustomerEmail</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block font-heading">COMMS PHONE</span>
                    <span class="text-white">@Model.CustomerPhone</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block font-heading">PAYMENT METHOD</span>
                    <span class="text-purple font-heading fw-bold">@Model.PaymentMethod</span>
                </div>
                <div class="col-12">
                    <span class="text-muted d-block font-heading">PHYSICAL SHIPPING COORDINATES</span>
                    <span class="text-white">@Model.ShippingAddress, @Model.City, @Model.State @Model.PostalCode, @Model.Country</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Status Advancement Controls -->
    <div class="col-lg-4">
        <!-- Order Fulfillment Status Control -->
        <div class="glass-panel p-4 mb-4 border-cyan">
            <h5 class="h6 font-display text-white mb-3 text-uppercase" style="letter-spacing: 1px;">
                Dispatch Status
            </h5>
            <div class="mb-3">
                <span class="small text-muted font-heading d-block mb-1">CURRENT STATUS:</span>
                <span class="badge-cyber badge-cyber-purple fs-6">@Model.Status</span>
            </div>

            <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <label class="form-label small font-heading fw-bold text-secondary">TRANSITION STATUS TO:</label>
                <select name="status" class="form-select form-select-cyber form-select-sm mb-3">
                    <option value="0" selected="@(Model.Status == ECommerce.Core.Enums.OrderStatus.Pending)">Pending</option>
                    <option value="1" selected="@(Model.Status == ECommerce.Core.Enums.OrderStatus.Processing)">Processing</option>
                    <option value="2" selected="@(Model.Status == ECommerce.Core.Enums.OrderStatus.Shipped)">Shipped</option>
                    <option value="3" selected="@(Model.Status == ECommerce.Core.Enums.OrderStatus.Delivered)">Delivered</option>
                    <option value="4" selected="@(Model.Status == ECommerce.Core.Enums.OrderStatus.Cancelled)">Cancelled</option>
                </select>
                <button type="submit" class="btn btn-cyber-cyan btn-sm w-100">
                    <i class="bi bi-arrow-repeat me-1"></i> Update Fulfillment Status
                </button>
            </form>
        </div>

        <!-- Payment Settlement Control -->
        <div class="glass-panel p-4 mb-4">
            <h5 class="h6 font-display text-white mb-3 text-uppercase" style="letter-spacing: 1px;">
                Settlement Status
            </h5>
            <div class="mb-3">
                <span class="small text-muted font-heading d-block mb-1">PAYMENT STATUS:</span>
                @if (Model.PaymentStatus == ECommerce.Core.Enums.PaymentStatus.Paid)
                {
                    <span class="badge-cyber badge-cyber-green fs-6">PAID</span>
                }
                else
                {
                    <span class="badge-cyber badge-cyber-purple fs-6">@Model.PaymentStatus</span>
                }
            </div>

            <form asp-area="Admin" asp-controller="Orders" asp-action="UpdatePaymentStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <label class="form-label small font-heading fw-bold text-secondary">SET PAYMENT STATUS:</label>
                <select name="status" class="form-select form-select-cyber form-select-sm mb-3">
                    <option value="0" selected="@(Model.PaymentStatus == ECommerce.Core.Enums.PaymentStatus.Pending)">Pending</option>
                    <option value="1" selected="@(Model.PaymentStatus == ECommerce.Core.Enums.PaymentStatus.Paid)">Paid</option>
                    <option value="2" selected="@(Model.PaymentStatus == ECommerce.Core.Enums.PaymentStatus.Failed)">Failed</option>
                    <option value="3" selected="@(Model.PaymentStatus == ECommerce.Core.Enums.PaymentStatus.Refunded)">Refunded</option>
                </select>
                <button type="submit" class="btn btn-cyber-primary btn-sm w-100">
                    <i class="bi bi-shield-check me-1"></i> Update Payment Status
                </button>
            </form>
        </div>
    </div>
</div>

