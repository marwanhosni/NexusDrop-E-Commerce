@model IReadOnlyList<ECommerce.Application.DTOs.CategoryDto>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
    <div>
        <h1 class="h3 font-display text-white mb-1">
            <i class="bi bi-tags-fill text-pink me-2"></i>CATEGORY NODES MANAGEMENT
        </h1>
        <p class="text-secondary small mb-0">Manage catalog taxonomy, display orders, and icon bindings.</p>
    </div>
    <div>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-cyber-primary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-folder-plus"></i> New Category
        </a>
    </div>
</div>

<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-cyber mb-0 align-middle">
            <thead>
                <tr>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Products Count</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td style="width: 50px;">
                            <div class="p-2 rounded-2 glass-card text-center text-cyan fs-5">
                                <i class="bi @(c.IconClass ?? "bi-tag")"></i>
                            </div>
                        </td>
                        <td>
                            <span class="text-white font-heading fw-bold">@c.Name</span>
                            <div class="text-muted small" style="line-height: 1.3;">@c.Description</div>
                        </td>
                        <td>
                            <span class="font-display small text-secondary">@c.Slug</span>
                        </td>
                        <td>
                            <span class="badge-cyber badge-cyber-purple">@c.ProductCount items</span>
                        </td>
                        <td class="font-display small text-white">
                            @c.DisplayOrder
                        </td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge-cyber badge-cyber-cyan">ACTIVE</span>
                            }
                            else
                            {
                                <span class="badge-cyber badge-cyber-red">INACTIVE</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-cyber-outline btn-sm py-1 px-2" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete or deactivate this category?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link text-danger p-0 ms-2" title="Delete">
                                        <i class="bi bi-trash3 fs-6"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

