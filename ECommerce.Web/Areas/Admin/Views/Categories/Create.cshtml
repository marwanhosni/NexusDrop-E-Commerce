@model ECommerce.Application.DTOs.CategoryDto
@{
    ViewData["Title"] = "Create Category";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
    <div>
        <h1 class="h3 font-display text-white mb-1">
            <i class="bi bi-folder-plus text-pink me-2"></i>CREATE CATEGORY NODE
        </h1>
        <p class="text-secondary small mb-0">Add a new merchandise classification category.</p>
    </div>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-cyber-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="glass-panel p-4 p-md-5">
            <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-panel border-pink text-white small mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small font-heading fw-bold text-secondary">CATEGORY NAME</label>
                    <input asp-for="Name" class="form-control form-control-cyber" placeholder="e.g. Cyber Footwear" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label small font-heading fw-bold text-secondary">SLUG (OPTIONAL, AUTO-GENERATED IF BLANK)</label>
                    <input asp-for="Slug" class="form-control form-control-cyber" placeholder="cyber-footwear" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label asp-for="IconClass" class="form-label small font-heading fw-bold text-secondary">BOOTSTRAP ICON CLASS</label>
                        <input asp-for="IconClass" class="form-control form-control-cyber" placeholder="bi-tag-fill" />
                        <span asp-validation-for="IconClass" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="DisplayOrder" class="form-label small font-heading fw-bold text-secondary">DISPLAY ORDER</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control form-control-cyber" value="1" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small font-heading fw-bold text-secondary">DESCRIPTION</label>
                    <textarea asp-for="Description" class="form-control form-control-cyber" rows="3" placeholder="Category purpose and aesthetic line."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="form-check p-3 glass-card mb-4 ms-0">
                    <input class="form-check-input bg-dark border-secondary ms-1" type="checkbox" asp-for="IsActive" checked />
                    <label class="form-check-label small text-white font-heading ms-2" asp-for="IsActive">
                        Active in Storefront
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-cyber-primary py-2 px-4">
                        <i class="bi bi-save me-1"></i> Create Category
                    </button>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-cyber-outline py-2 px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

