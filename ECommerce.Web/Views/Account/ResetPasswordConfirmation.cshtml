@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="glass-panel p-4 p-md-5 text-center position-relative" style="border: 1px solid rgba(16, 185, 129, 0.4); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);">
                <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4);">
                    <i class="bi bi-check-circle-fill text-success fs-2"></i>
                </div>
                
                <h1 class="h4 font-display text-white mb-2">ACCESS KEY RESET SUCCESSFUL</h1>
                <p class="text-secondary small mb-4">
                    Your password has been cryptographically updated in the central registry. You may now authenticate with your new credentials.
                </p>

                <a asp-action="Login" class="btn btn-cyber-primary w-100 py-2 font-heading fw-bold text-uppercase d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-in-right"></i> Authenticate with New Key
                </a>
            </div>
        </div>
    </div>
</div>
