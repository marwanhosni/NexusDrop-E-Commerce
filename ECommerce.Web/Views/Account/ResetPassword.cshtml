@model ECommerce.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Initialize New Access Key";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="glass-panel p-4 p-md-5 position-relative" style="border: 1px solid rgba(168, 85, 247, 0.4); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.4);">
                        <i class="bi bi-key-fill text-purple fs-2"></i>
                    </div>
                    <h1 class="h4 font-display text-white mb-1">INITIALIZE NEW KEY</h1>
                    <p class="text-secondary small">Set a new, secure password for <strong>@Model.Email</strong>.</p>
                </div>

                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-panel border-pink text-white small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small font-heading fw-bold text-secondary">NEW AUTHENTICATION KEY (PASSWORD)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-cyan"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Password" class="form-control form-control-cyber" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small font-heading fw-bold text-secondary">CONFIRM NEW KEY</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-purple"><i class="bi bi-check2-circle"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control form-control-cyber" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-cyber-primary w-100 py-2 font-heading fw-bold text-uppercase d-flex align-items-center justify-content-center gap-2 mb-3">
                        <i class="bi bi-shield-check"></i> Commit New Access Key
                    </button>

                    <div class="text-center pt-3 border-top border-secondary border-opacity-25">
                        <a asp-action="Login" class="small text-cyan font-heading fw-bold text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Cancel and Return to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
