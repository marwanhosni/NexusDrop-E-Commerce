@model ECommerce.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Access Key";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="glass-panel p-4 p-md-5 position-relative" style="border: 1px solid rgba(6, 182, 212, 0.4); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.4);">
                        <i class="bi bi-shield-lock-fill text-cyan fs-2"></i>
                    </div>
                    <h1 class="h4 font-display text-white mb-1">RECOVER ACCESS KEY</h1>
                    <p class="text-secondary small">Enter your verified email to receive cryptographic password reset credentials.</p>
                </div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-panel border-pink text-white small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small font-heading fw-bold text-secondary">REGISTERED EMAIL ADDRESS</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-cyan"><i class="bi bi-envelope-at-fill"></i></span>
                            <input asp-for="Email" class="form-control form-control-cyber" placeholder="operator@cybernet.io" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-cyber-primary w-100 py-2 font-heading fw-bold text-uppercase d-flex align-items-center justify-content-center gap-2 mb-3">
                        <i class="bi bi-send-fill"></i> Transmit Reset Protocol
                    </button>

                    <div class="text-center pt-3 border-top border-secondary border-opacity-25">
                        <a asp-action="Login" class="small text-cyan font-heading fw-bold text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Return to Authentication Terminal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
