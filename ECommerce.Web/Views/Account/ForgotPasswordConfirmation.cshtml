@{
    ViewData["Title"] = "Reset Protocol Dispatched";
    var resetLink = ViewBag.ResetLink as string;
    var targetEmail = ViewBag.TargetEmail as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="glass-panel p-4 p-md-5 text-center position-relative" style="border: 1px solid rgba(16, 185, 129, 0.4); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);">
                <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4);">
                    <i class="bi bi-envelope-check-fill text-success fs-2"></i>
                </div>
                
                <h1 class="h4 font-display text-white mb-2">SECURITY TRANSMISSION DISPATCHED</h1>
                <p class="text-secondary small mb-4">
                    If an account matching <strong>@(targetEmail ?? "your email")</strong> exists on the network, a cryptographic password reset link has been dispatched.
                </p>

                @if (!string.IsNullOrEmpty(resetLink))
                {
                    <div class="glass-card p-3 mb-4 text-start border-cyan" style="background: rgba(6, 182, 212, 0.08);">
                        <div class="small font-display text-cyan mb-1">
                            <i class="bi bi-terminal-fill me-1"></i> LOCAL DEVELOPMENT DIRECT LINK:
                        </div>
                        <div class="small text-muted mb-2 font-mono" style="font-size: 0.75rem;">
                            (In production, this link is delivered directly to the user's inbox).
                        </div>
                        <a href="@resetLink" class="btn btn-cyber-primary btn-sm w-100 text-truncate font-heading">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Proceed to Reset Password Screen
                        </a>
                    </div>
                }

                <a asp-action="Login" class="btn btn-cyber-outline py-2 px-4 font-heading text-uppercase">
                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
