@model ECommerce.Application.DTOs.OrderDto
@{
    ViewData["Title"] = $"Order {Model.OrderNumber} Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Success Card Banner -->
            <div class="glass-panel p-4 p-md-5 text-center mb-4 position-relative overflow-hidden" style="border: 1px solid #06b6d4; box-shadow: 0 0 30px rgba(6, 182, 212, 0.2);">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle p-3 glass-panel border-cyan" style="width: 80px; height: 80px; box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);">
                        <i class="bi bi-check-lg text-cyan display-5"></i>
                    </span>
                </div>

                <span class="badge-cyber badge-cyber-green mb-2">TRANSMISSION LOCKED</span>
                <h1 class="h2 font-display text-white mb-2">ORDER INITIALIZED SUCCESSFULLY</h1>
                <p class="text-secondary small mb-4" style="max-width: 500px; margin: 0 auto;">
                    Your request has been encoded into the production queue. Your order manifest and dispatch token have been beamed to <span class="text-white fw-bold">@Model.CustomerEmail</span>.
                </p>

                <div class="d-inline-flex flex-column flex-sm-row align-items-center gap-3 p-3 glass-card border-secondary">
                    <div class="text-sm-start">
                        <div class="small text-muted font-heading">ORDER TRACKING IDENTIFIER:</div>
                        <div class="font-display fw-bold text-cyan fs-5">@Model.OrderNumber</div>
                    </div>
                    <div class="border-start border-secondary d-none d-sm-block ps-3 text-sm-start">
                        <div class="small text-muted font-heading">STATUS:</div>
                        <span class="badge-cyber badge-cyber-purple">@Model.Status</span>
                    </div>
                </div>
            </div>

            <!-- Receipt & Manifest Details -->
            <div class="glass-panel p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <h5 class="h6 font-display text-white mb-0 text-uppercase" style="letter-spacing: 1px;">
                        Manifest Breakdown
                    </h5>
                    <span class="small text-muted">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm UTC")</span>
                </div>

                <!-- Purchased items -->
                <div class="table-responsive mb-4">
                    <table class="table table-cyber mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Unit</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                            {
                                                <div class="glass-card p-1 text-center" style="width: 44px; height: 44px; border-radius: 8px; background: #0c0e17;">
                                                    <img src="@item.ProductImageUrl" alt="@item.ProductName" class="w-100 h-100 object-fit-contain" />
                                                </div>
                                            }
                                            <span class="text-white font-heading fw-bold small">@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td class="text-center font-display text-white small">@item.Quantity</td>
                                    <td class="text-end font-display text-secondary small">$@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-end font-display text-cyan fw-bold small">$@item.TotalPrice.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Financial totals -->
                <div class="row g-4 pt-2">
                    <div class="col-sm-6">
                        <h6 class="small font-display text-secondary text-uppercase mb-2">Delivery Coordinates</h6>
                        <div class="small text-white font-heading fw-bold">@Model.CustomerName</div>
                        <div class="small text-secondary">@Model.ShippingAddress</div>
                        <div class="small text-secondary">@Model.City, @Model.State @Model.PostalCode</div>
                        <div class="small text-secondary">@Model.Country</div>
                        <div class="small text-secondary mt-1"><i class="bi bi-telephone me-1"></i>@Model.CustomerPhone</div>
                    </div>

                    <div class="col-sm-6 text-sm-end">
                        <div class="d-flex justify-content-between justify-content-sm-end gap-sm-4 mb-1 small">
                            <span class="text-secondary">Subtotal:</span>
                            <span class="text-white font-display fw-bold">$@Model.Subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between justify-content-sm-end gap-sm-4 mb-1 small">
                            <span class="text-secondary">Sub-Orbital Shipping:</span>
                            <span class="text-white font-display fw-bold">$@Model.ShippingCost.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between justify-content-sm-end gap-sm-4 mb-2 small">
                            <span class="text-secondary">Tax (8%):</span>
                            <span class="text-white font-display fw-bold">$@Model.TaxAmount.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between justify-content-sm-end gap-sm-4 pt-2 border-top border-secondary border-opacity-25">
                            <span class="font-heading fw-bold text-white">TOTAL CHARGED:</span>
                            <span class="font-display fw-bold text-cyan fs-5">$@Model.TotalAmount.ToString("F2")</span>
                        </div>
                        <div class="small text-muted font-heading mt-1">Settled via @Model.PaymentMethod</div>
                    </div>
                </div>
            </div>

            <!-- Next actions -->
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-cyber-primary">
                    <i class="bi bi-arrow-left me-1"></i> Return to Grid
                </a>
                <button type="button" class="btn btn-cyber-outline" onclick="window.print();">
                    <i class="bi bi-printer me-1"></i> Print Manifest
                </button>
            </div>
        </div>
    </div>
</div>

