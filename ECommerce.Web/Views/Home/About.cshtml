@{
    ViewData["Title"] = "About Marwan Hosny Store & Official Merchandise";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Home</a></li>
            <li class="breadcrumb-item active text-cyan" aria-current="page">About Marwan Hosny Store</li>
        </ol>
    </nav>

    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge-cyber badge-cyber-purple mb-2">MARWAN HOSNY OFFICIAL MERCH</span>
            <h1 class="display-5 font-display text-white mb-3">SYNTHETIC APPAREL &amp; TECH MERCHANDISE</h1>
            <p class="lead text-secondary-cyber fs-6 mb-4" style="line-height: 1.8;">
                Founded by Marwan Hosny in 2026, Marwan Hosny Store brings together techwear fashion, digital creator culture, and futuristic aesthetics. We reject disposable fast fashion in favor of aerospace-grade materials, durable high-density screens, and smart NFC-embedded physical merchandise.
            </p>
            <div class="row g-3">
                <div class="col-6">
                    <div class="glass-card p-3">
                        <div class="font-display fw-bold fs-4 text-cyan">100%</div>
                        <div class="small text-secondary font-heading">Authentic Verification</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="glass-card p-3">
                        <div class="font-display fw-bold fs-4 text-purple">280GSM</div>
                        <div class="small text-secondary font-heading">Heavy French Terry</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 text-center">
            <div class="glass-panel p-4 d-inline-block border-cyan" style="box-shadow: 0 0 40px rgba(6, 182, 212, 0.2);">
                <img src="~/images/products/tshirt-quantum.svg" alt="Quantum Glitch Tee" class="img-fluid" style="max-height: 380px;" />
            </div>
        </div>
    </div>

    <!-- Tech Stack Highlights -->
    <div class="row g-4 my-4">
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100">
                <i class="bi bi-cpu text-cyan fs-2 mb-3 d-block"></i>
                <h4 class="h5 font-heading text-white fw-bold mb-2">Embedded NFC Hardware</h4>
                <p class="small text-secondary mb-0">Every garment features a flexible waterproof micro-NFC tag sewn into the lower hem, pairing with your smartphone to verify authenticity.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100">
                <i class="bi bi-shield-shaded text-purple fs-2 mb-3 d-block"></i>
                <h4 class="h5 font-heading text-white fw-bold mb-2">Neodymium Fasteners</h4>
                <p class="small text-secondary mb-0">Our enamel badges and pins use dual NdFeB magnetic couplings so you never punch holes into your premium techwear jackets.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100">
                <i class="bi bi-fire text-pink fs-2 mb-3 d-block"></i>
                <h4 class="h5 font-heading text-white fw-bold mb-2">Thermochromic Glaze</h4>
                <p class="small text-secondary mb-0">Our drinkware line features proprietary temperature-sensitive microscopic pigment grids that reveal circuit schematics at 65°C.</p>
            </div>
        </div>
    </div>
</div>

