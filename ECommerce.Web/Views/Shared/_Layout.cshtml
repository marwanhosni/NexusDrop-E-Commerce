@inject ECommerce.Application.Interfaces.ICartService CartService
@inject Microsoft.AspNetCore.Identity.UserManager<ECommerce.Core.Entities.ApplicationUser> UserManager
@{
    var cartId = Context.Request.Cookies[".MarwanHosnyStore.CartId"] ?? "";
    var currentUserId = UserManager.GetUserId(User);
    var currentCart = await CartService.GetCartAsync(cartId, currentUserId);
    var cartItemCount = currentCart.TotalItemCount;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marwan Hosny Store | Futuristic Cyber Merchandise</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Animate CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <!-- Custom Futuristic Cyber CSS -->
    <link rel="stylesheet" href="~/css/futuristic.css" asp-append-version="true" />
</head>
<body>
    <!-- Cyberpunk Glassmorphic Navbar -->
    <nav class="navbar navbar-expand-lg glass-nav py-3">
        <div class="container">
            <a class="navbar-brand navbar-brand-cyber" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.svg" alt="Marwan Hosny Store" />
            </a>

            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCyber" aria-controls="navbarCyber" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-cyan"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarCyber">
                <!-- Center Links -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link-cyber @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill me-1 text-cyan"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-cyber @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Catalog" && ViewContext.RouteData.Values["categorySlug"] == null ? "active" : "")" asp-controller="Catalog" asp-action="Index">
                            <i class="bi bi-lightning-charge-fill me-1 text-purple"></i> All Merch
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-cyber" asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="t-shirts">
                            <i class="bi bi-tag-fill me-1 text-pink"></i> T-Shirts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-cyber" asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="mugs">
                            <i class="bi bi-cup-hot-fill me-1 text-cyan"></i> Mugs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-cyber" asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="badges">
                            <i class="bi bi-shield-shaded me-1 text-blue"></i> Badges
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-cyber" asp-controller="Home" asp-action="About">
                            <i class="bi bi-cpu-fill me-1 text-secondary"></i> About
                        </a>
                    </li>
                </ul>

                <!-- Right Utility Bar -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Global Search Form -->
                    <form asp-controller="Catalog" asp-action="Index" method="get" class="d-none d-xl-flex position-relative">
                        <input type="text" name="Query" class="form-control form-control-cyber form-control-sm pe-4" placeholder="Search cyber artifacts..." style="width: 210px; font-size: 0.85rem;" />
                        <button type="submit" class="btn btn-link text-secondary position-absolute end-0 top-50 translate-middle-y text-decoration-none pe-2">
                            <i class="bi bi-search text-cyan"></i>
                        </button>
                    </form>

                    <!-- Cart Pill -->
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-cyber-outline cart-pill py-2 px-3 d-flex align-items-center gap-2">
                        <i class="bi bi-bag-check-fill text-cyan fs-6"></i>
                        <span class="d-none d-sm-inline font-heading fw-bold">Cart</span>
                        <span class="cart-badge cart-badge-count" style="@(cartItemCount > 0 ? "display: flex;" : "display: none;")">
                            @cartItemCount
                        </span>
                    </a>

                    <!-- User Account / Admin Area -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-cyber-outline dropdown-toggle d-flex align-items-center gap-2 py-2" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle text-purple fs-5"></i>
                                <span class="d-none d-md-inline small font-heading fw-semibold">@User.Identity.Name?.Split('@')[0]</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end glass-panel mt-2 shadow-lg border-secondary" aria-labelledby="userMenuDropdown">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 text-cyan fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i> Admin Command Deck
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary opacity-50"></li>
                                }
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-badge me-2 text-purple"></i> Profile & Coordinates
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-box-seam me-2 text-cyan"></i> Order History
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary opacity-50"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-cyber-outline w-100 btn-sm text-start text-danger border-0">
                                            <i class="bi bi-box-arrow-right me-2"></i> Disconnect
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-cyber-outline btn-sm">
                                <i class="bi bi-key-fill me-1 text-cyan"></i> Access
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-cyber-cyan btn-sm d-none d-sm-inline-block">
                                Register
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Toast / Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success glass-panel border-cyan text-white alert-dismissible fade show d-flex align-items-center" role="alert" style="box-shadow: 0 0 20px var(--neon-cyan-glow);">
                <i class="bi bi-check-circle-fill text-cyan fs-4 me-3"></i>
                <div class="font-heading fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger glass-panel border-pink text-white alert-dismissible fade show d-flex align-items-center" role="alert" style="box-shadow: 0 0 20px var(--neon-pink-glow);">
                <i class="bi bi-exclamation-triangle-fill text-pink fs-4 me-3"></i>
                <div class="font-heading fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main Content Injection -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Futuristic Cyber Footer -->
    <footer class="footer-cyber text-secondary">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <img src="~/images/logo.svg" alt="Marwan Hosny Store" style="height: 38px;" class="mb-3" />
                    <p class="small text-secondary-cyber mb-4" style="line-height: 1.8;">
                        Official merchandise line curated by Marwan Hosny. Engineered for creators, developers, and synthwave enthusiasts. Heavyweight carbon-weave fabrics, thermochromic ceramic engineering, and high-frequency luminescent inks.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge-cyber badge-cyber-purple"><i class="bi bi-shield-check me-1"></i> Quantum Encrypted</span>
                        <span class="badge-cyber badge-cyber-cyan"><i class="bi bi-box-seam me-1"></i> Sub-Orbital Ship</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white font-display mb-3 text-uppercase small" style="letter-spacing: 2px;">Merchandise</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-secondary hover-cyan">Full Artifact Grid</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="t-shirts" class="text-decoration-none text-secondary hover-cyan">Cyber T-Shirts</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="mugs" class="text-decoration-none text-secondary hover-cyan">Reactor Mugs</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="badges" class="text-decoration-none text-secondary hover-cyan">Enamel Badges</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white font-display mb-3 text-uppercase small" style="letter-spacing: 2px;">Protocols</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="About" class="text-decoration-none text-secondary hover-cyan">Tech Specs & Lore</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-decoration-none text-secondary hover-cyan">Neural Dispatch</a></li>
                        <li><a asp-controller="Account" asp-action="Login" class="text-decoration-none text-secondary hover-cyan">Grid Access</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="text-decoration-none text-secondary hover-cyan">Initialize Account</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white font-display mb-3 text-uppercase small" style="letter-spacing: 2px;">Cyber Dispatch</h6>
                    <p class="small text-secondary-cyber mb-3">
                        Subscribe to encrypted transmissions for limited batch drops, zero-day discount keys, and secret pin releases.
                    </p>
                    <div class="input-group">
                        <input type="email" class="form-control form-control-cyber form-control-sm" placeholder="operator@cybernet.io" />
                        <button class="btn btn-cyber-primary btn-sm px-3" type="button">Subscribe</button>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-top border-secondary border-opacity-25 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small">
                <div>
                    &copy; 2026 <span class="text-white font-display">Marwan Hosny Store</span>. Built on .NET 9 &amp; ASP.NET Core MVC Architecture.
                </div>
                <div class="d-flex gap-3 text-muted">
                    <span>STATUS: ALL NODES NOMINAL</span>
                    <span>•</span>
                    <span>TLS 1.3 ENCRYPTED</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom Cyber JS -->
    <script src="~/js/cyber.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
