@model ECommerce.Web.Models.CatalogViewModel
@{
    var title = Model.CurrentCategory != null ? $"{Model.CurrentCategory.Name} Collection" : "All Cyber Artifacts";
    ViewData["Title"] = title;
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-secondary">Catalog</a></li>
            @if (Model.CurrentCategory != null)
            {
                <li class="breadcrumb-item active text-cyan" aria-current="page">@Model.CurrentCategory.Name</li>
            }
            else
            {
                <li class="breadcrumb-item active text-cyan" aria-current="page">All Products</li>
            }
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
        <div>
            <h1 class="h2 font-display text-white mb-1">@title</h1>
            <p class="text-secondary small mb-0">
                Displaying <span class="text-cyan fw-bold">@Model.Products.TotalCount</span> available quantum items on the grid
            </p>
        </div>

        <!-- Sort Control Form -->
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="Query" value="@Model.Filter.Query" />
            <input type="hidden" name="CategoryId" value="@Model.Filter.CategoryId" />
            <input type="hidden" name="CategorySlug" value="@Model.Filter.CategorySlug" />
            <input type="hidden" name="MinPrice" value="@Model.Filter.MinPrice" />
            <input type="hidden" name="MaxPrice" value="@Model.Filter.MaxPrice" />
            <input type="hidden" name="InStockOnly" value="@(Model.Filter.InStockOnly == true ? "true" : "false")" />

            <label class="small text-secondary font-heading text-nowrap">Sort By:</label>
            <select name="SortBy" class="form-select form-select-cyber form-select-sm" style="width: 170px;" onchange="this.form.submit()">
                <option value="newest" selected="@(Model.Filter.SortBy == "newest" || string.IsNullOrEmpty(Model.Filter.SortBy))">Newest Releases</option>
                <option value="featured" selected="@(Model.Filter.SortBy == "featured")">Featured Drops</option>
                <option value="price_asc" selected="@(Model.Filter.SortBy == "price_asc")">Price: Low to High</option>
                <option value="price_desc" selected="@(Model.Filter.SortBy == "price_desc")">Price: High to Low</option>
            </select>
        </form>
    </div>

    <div class="row g-4">
        <!-- Filter Sidebar -->
        <div class="col-lg-3">
            <div class="glass-panel p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="h6 font-display text-white mb-0 text-uppercase" style="letter-spacing: 1px;">
                        <i class="bi bi-funnel-fill text-cyan me-1"></i> Filter Grid
                    </h5>
                    @if (!string.IsNullOrEmpty(Model.Filter.Query) || Model.Filter.CategoryId.HasValue || !string.IsNullOrEmpty(Model.Filter.CategorySlug) || Model.Filter.MinPrice.HasValue || Model.Filter.MaxPrice.HasValue)
                    {
                        <a asp-controller="Catalog" asp-action="Index" class="small text-pink text-decoration-none font-heading">
                            <i class="bi bi-x-circle me-1"></i>Reset
                        </a>
                    }
                </div>

                <form method="get" asp-controller="Catalog" asp-action="Index">
                    <input type="hidden" name="SortBy" value="@Model.Filter.SortBy" />

                    <!-- Search Input -->
                    <div class="mb-4">
                        <label class="form-label small text-secondary font-heading fw-bold">SEARCH KEYWORD</label>
                        <div class="input-group">
                            <input type="text" name="Query" class="form-control form-control-cyber form-control-sm" placeholder="SKU, Name, Tag..." value="@Model.Filter.Query" />
                            <button class="btn btn-cyber-primary btn-sm" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Category Filter -->
                    <div class="mb-4">
                        <label class="form-label small text-secondary font-heading fw-bold">CATEGORIES</label>
                        <div class="d-flex flex-column gap-2">
                            <a asp-controller="Catalog" asp-action="Index" asp-route-Query="@Model.Filter.Query" asp-route-SortBy="@Model.Filter.SortBy" 
                               class="d-flex justify-content-between align-items-center text-decoration-none px-2 py-1 rounded-2 @(Model.CurrentCategory == null ? "bg-white bg-opacity-10 text-cyan fw-bold" : "text-secondary hover-cyan")">
                                <span class="small"><i class="bi bi-grid-fill me-2"></i>All Categories</span>
                                <span class="badge-cyber badge-cyber-purple">@Model.Categories.Sum(c => c.ProductCount)</span>
                            </a>
                            @foreach (var cat in Model.Categories)
                            {
                                var isActive = Model.CurrentCategory?.Id == cat.Id;
                                <a asp-controller="Catalog" asp-action="Index" asp-route-categorySlug="@cat.Slug" asp-route-Query="@Model.Filter.Query" asp-route-SortBy="@Model.Filter.SortBy"
                                   class="d-flex justify-content-between align-items-center text-decoration-none px-2 py-1 rounded-2 @(isActive ? "bg-white bg-opacity-10 text-cyan fw-bold" : "text-secondary hover-cyan")">
                                    <span class="small"><i class="bi @(cat.IconClass ?? "bi-tag") me-2"></i>@cat.Name</span>
                                    <span class="badge-cyber badge-cyber-purple">@cat.ProductCount</span>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Price Filter -->
                    <div class="mb-4">
                        <label class="form-label small text-secondary font-heading fw-bold">PRICE RANGE ($)</label>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <input type="number" step="1" name="MinPrice" class="form-control form-control-cyber form-control-sm" placeholder="Min" value="@Model.Filter.MinPrice" />
                            </div>
                            <div class="col-6">
                                <input type="number" step="1" name="MaxPrice" class="form-control form-control-cyber form-control-sm" placeholder="Max" value="@Model.Filter.MaxPrice" />
                            </div>
                        </div>
                    </div>

                    <!-- In Stock Checkbox -->
                    <div class="form-check mb-4">
                        <input class="form-check-input bg-dark border-secondary" type="checkbox" name="InStockOnly" value="true" id="inStockCheck" @(Model.Filter.InStockOnly == true ? "checked" : "") />
                        <label class="form-check-label small text-secondary font-heading" for="inStockCheck">
                            In Stock Units Only
                        </label>
                    </div>

                    <button type="submit" class="btn btn-cyber-cyan btn-sm w-100">
                        Apply Filters
                    </button>
                </form>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-lg-9">
            @if (!Model.Products.Items.Any())
            {
                <div class="glass-panel p-5 text-center my-4">
                    <i class="bi bi-radar text-cyan fs-1 mb-3 d-block"></i>
                    <h3 class="h4 font-display text-white mb-2">NO ARTIFACTS DETECTED</h3>
                    <p class="text-secondary small mb-4">No merchandise matched your search parameters. Try broadening your filter criteria.</p>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-cyber-primary">
                        Reset All Filters
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    @foreach (var product in Model.Products.Items)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="product-card">
                                <!-- Badges -->
                                <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-1" style="z-index: 2;">
                                    @if (product.HasDiscount)
                                    {
                                        <span class="badge-cyber badge-cyber-red">-@product.DiscountPercentage% OFF</span>
                                    }
                                    @if (product.IsFeatured)
                                    {
                                        <span class="badge-cyber badge-cyber-purple"><i class="bi bi-lightning-charge-fill me-1"></i> TOP PICK</span>
                                    }
                                </div>

                                <!-- Image Wrap -->
                                <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@product.Slug" class="product-card-img-wrap text-decoration-none">
                                    <img src="@product.PrimaryImageUrl" alt="@product.Name" loading="lazy" />
                                </a>

                                <!-- Body -->
                                <div class="product-card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-cyan font-heading text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">
                                            @product.CategoryName
                                        </span>
                                        <span class="small @(product.InStock ? "text-success" : "text-danger") font-heading" style="font-size: 0.75rem;">
                                            <i class="bi @(product.InStock ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                            @(product.InStock ? $"{product.StockQuantity} In Stock" : "Sold Out")
                                        </span>
                                    </div>

                                    <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@product.Slug" class="product-card-title">
                                        @product.Name
                                    </a>

                                    <p class="small text-secondary mb-3" style="line-height: 1.5; height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        @product.ShortDescription
                                    </p>

                                    <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="product-price-current">$@product.Price.ToString("F2")</span>
                                            @if (product.HasDiscount)
                                            {
                                                <span class="product-price-original">$@product.OriginalPrice?.ToString("F2")</span>
                                            }
                                        </div>

                                        <div class="d-flex gap-2">
                                            <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@product.Slug" class="btn btn-cyber-outline btn-sm px-2" title="Inspect Specs">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (product.InStock)
                                            {
                                                <button type="button" class="btn btn-cyber-primary btn-sm btn-quick-add-cart d-flex align-items-center gap-1" data-product-id="@product.Id">
                                                    <i class="bi bi-cart-plus-fill"></i> Add
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.Products.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-4">
                        <nav aria-label="Catalog pagination">
                            <ul class="pagination pagination-sm gap-1">
                                <li class="page-item @(!Model.Products.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link glass-card text-white border-secondary" 
                                       asp-controller="Catalog" asp-action="Index" 
                                       asp-route-PageNumber="@(Model.Products.PageNumber - 1)"
                                       asp-route-Query="@Model.Filter.Query"
                                       asp-route-CategoryId="@Model.Filter.CategoryId"
                                       asp-route-CategorySlug="@Model.Filter.CategorySlug"
                                       asp-route-MinPrice="@Model.Filter.MinPrice"
                                       asp-route-MaxPrice="@Model.Filter.MaxPrice"
                                       asp-route-SortBy="@Model.Filter.SortBy"
                                       asp-route-InStockOnly="@Model.Filter.InStockOnly">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int p = 1; p <= Model.Products.TotalPages; p++)
                                {
                                    var isCurrent = p == Model.Products.PageNumber;
                                    <li class="page-item @(isCurrent ? "active" : "")">
                                        <a class="page-link glass-card @(isCurrent ? "btn-cyber-primary text-white border-0" : "text-secondary border-secondary")" 
                                           asp-controller="Catalog" asp-action="Index" 
                                           asp-route-PageNumber="@p"
                                           asp-route-Query="@Model.Filter.Query"
                                           asp-route-CategoryId="@Model.Filter.CategoryId"
                                           asp-route-CategorySlug="@Model.Filter.CategorySlug"
                                           asp-route-MinPrice="@Model.Filter.MinPrice"
                                           asp-route-MaxPrice="@Model.Filter.MaxPrice"
                                           asp-route-SortBy="@Model.Filter.SortBy"
                                           asp-route-InStockOnly="@Model.Filter.InStockOnly">
                                            @p
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(!Model.Products.HasNextPage ? "disabled" : "")">
                                    <a class="page-link glass-card text-white border-secondary" 
                                       asp-controller="Catalog" asp-action="Index" 
                                       asp-route-PageNumber="@(Model.Products.PageNumber + 1)"
                                       asp-route-Query="@Model.Filter.Query"
                                       asp-route-CategoryId="@Model.Filter.CategoryId"
                                       asp-route-CategorySlug="@Model.Filter.CategorySlug"
                                       asp-route-MinPrice="@Model.Filter.MinPrice"
                                       asp-route-MaxPrice="@Model.Filter.MaxPrice"
                                       asp-route-SortBy="@Model.Filter.SortBy"
                                       asp-route-InStockOnly="@Model.Filter.InStockOnly">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

